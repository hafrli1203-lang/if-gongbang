def _default_workspace_root() -> Path:
    return Path.home() / ".gongbang" / "workspace"


GB2_WORKSPACE = Path(os.environ.get("GB2_WORKSPACE", str(_default_workspace_root())))
APPS_DIR = GB2_WORKSPACE / "apps"
TEMPLATES_DIR = Path(__file__).resolve().parent / "templates"
WORKTREE_BRANCH = "gb2/work"
WORKTREE_BASE = "master"


def _apps_root() -> Path:
    """The directory holding each app's own source repo -- read lazily
    (only by the subcommands that actually need it: init, diff) rather
    than resolved at import time, so importing this module, or running
    a subcommand that only touches GB2_WORKSPACE, never requires
    GB2_APPS_ROOT to be set."""
    value = os.environ.get("GB2_APPS_ROOT")
    if not value:
        raise SystemExit(
            "GB2_APPS_ROOT is not set -- export it to the directory that "
            "holds each app's own source repo before running init/diff"
        )
    return Path(value)


def _deploy_script_path(apps_root: Path) -> Path:
    """GB2_DEPLOY_SCRIPT if set, else "<apps_root>/_shared/deploy.sh" --
    read lazily (cmd_init only), same reasoning as _apps_root."""
    value = os.environ.get("GB2_DEPLOY_SCRIPT")
    return Path(value) if value else (apps_root / "_shared" / "deploy.sh")


# A single safe path component: no "/", no leading "-" (would otherwise
# be read as an option by something downstream), not "." or "..". An
# app name is joined onto both APPS_DIR and GB2_APPS_ROOT without any
# further escaping, so accepting anything else (a "/", an absolute-
# looking value, "..") would let `gb2 init` be pointed at an arbitrary
# path outside either root -- including, in the worst case, making the
# computed workspace and source repo paths the same directory.
_APP_NAME_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def _validate_app_name(app: str) -> None:
    if app in (".", ".."):
        raise ValueError(f"invalid app name: {app!r}")
    if not _APP_NAME_RE.fullmatch(app) or app.startswith("-"):
        raise ValueError(
            f"invalid app name: {app!r} (must be a single path component "
            "matching [A-Za-z0-9._-]+, not '.', '..', or start with '-')"
        )


def _is_within(path: Path, base: Path) -> bool:
    try:
        path.relative_to(base)
        return True
    except ValueError:
        return False

NEGATIVE_CONTROL_TEST = '''\
// gb2 negative control -- fails only when GB2_NEGATIVE=1 is set, so the
// normal suite stays green while the bench can still prove its grader
// is not "always passes".
import { describe, expect, it } from "vitest";

describe("gb2 negative control", () => {
  it.skipIf(!process.env.GB2_NEGATIVE)("fails on purpose when GB2_NEGATIVE is set", () => {
    expect(1).toBe(2);
  });
});
'''

NEGATIVE_CONTROL_CASES = [
    {"name": "gb2_negative_control", "selector": "tests/gb2-negative-control.test.ts",
     "expect_fail": True, "expected_signature": "assertion", "env": {"GB2_NEGATIVE": "1"}},
]


def _bench_cases_need_upgrade(bench_cases_path: Path) -> bool:
    """True iff `bench_cases_path` already exists but its own
    "gb2_negative_control" entry's expected_signature is not the
    current one (engine.steps.bench_run._case_signature now classifies
    a real vitest assertion failure as "assertion", never "exit:1" --
    a workspace generated before that change would otherwise fail
    every bench run with wrong_failure_signature forever, since
    nothing else ever rewrites bench_cases.json once it exists)."""
    try:
        data = json.loads(bench_cases_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return False
    if not isinstance(data, list):
        return False
    for case in data:
        if (isinstance(case, dict) and case.get("name") == "gb2_negative_control"
                and case.get("expected_signature") != "assertion"):
            return True
    return False


