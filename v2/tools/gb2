# new / change / approve-design / continue (full orbit: engine.full_orbit
# .run_full_job/continue_full_job -- facts -> plan -> [design] -> build
# loop -> acceptance -> report, see
# (the full-orbit contract)
# --------------------------------------------------------------------

# Skeleton files `gb2 new` seeds a brand-new app repo with (relative to
# tools/templates/new-app/). Listed explicitly, never discovered via
# glob, so a dotfile like .gitignore is never silently skipped by a
# glob pattern that happens not to match leading dots on some Python
# version, and so adding a new skeleton file is a deliberate one-line
# change here, not an accident of what happens to be on disk.
_NEW_APP_SKELETON_FILES = (
    "README.md", ".gitignore", "package.json", "tests/scenes/.gitkeep",
)


def _render_skeleton_text(text: str, app_name: str) -> str:
    """The skeleton's only per-app substitution: a literal "__APP__"
    token (package.json's "name" field), same placeholder convention
    as the config template's render_config."""
    return text.replace("__APP__", app_name)


def _scaffold_new_app_repo(source_repo: Path, app: str) -> None:
    """Create `source_repo` as a brand-new git repository seeded from
    tools/templates/new-app/ (README, .gitignore, a minimal Node+Vitest
    package.json with no dependencies installed yet, an empty
    tests/scenes/ -- the planner role is the only one later allowed to
    write under tests/scenes/), with one initial commit. Refuses
    (raises ValueError, nothing created) if `source_repo` already
    exists -- callers must check that themselves before calling this,
    so a caller can distinguish "already exists" from any other
    failure before touching disk at all."""
    if source_repo.exists():
        raise ValueError(f"app_exists: {source_repo}")
    skeleton_dir = TEMPLATES_DIR / "new-app"
    if not skeleton_dir.is_dir():
        raise ValueError(f"missing skeleton template dir: {skeleton_dir}")
    source_repo.mkdir(parents=True)
    for rel in _NEW_APP_SKELETON_FILES:
        src = skeleton_dir / rel
        dest = source_repo / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(_render_skeleton_text(src.read_text(encoding="utf-8"), app),
                        encoding="utf-8")
    _git(["init", "-q", "-b", WORKTREE_BASE], cwd=source_repo)
    _git(["add", "-A"], cwd=source_repo)
    _git(["-c", "user.name=gb2", "-c", "user.email=gb2@local",
         "commit", "-q", "-m", f"chore: scaffold {app} via gb2 new"], cwd=source_repo)


def _exit_code_for_full_outcome(status: str) -> int:
    if status == "done":
        return 0
    if status == "needs_owner":
        return 2
    return 3


def _summarize_full_outcome(config: EngineConfig, ledger: Ledger, app: str,
                            outcome: object, wall_sec: float) -> dict[str, object]:
    """Same shape of summary as `_summarize` (JobOutcome), for a
    FullOutcome (engine.full_orbit): status/reason plus, only when the
    outcome carries an attempt_id (it may be None if the job never got
    as far as opening one), the commit it left and a changed-files
    diff against that attempt's base_head. report_path is passed
    through as-is -- engine.full_orbit/engine.handoff.write_handoff
    already decided where report.md lives."""
    attempt_id = getattr(outcome, "attempt_id", None)
    commit_hash = None
    changed_files: list[str] = []
    if attempt_id is not None:
        project = config.projects[app]
        try:
            commit_hash = _git(["rev-parse", "HEAD"], cwd=project.repo)
        except subprocess.CalledProcessError:
            pass
        try:
            base_head = None
            for _seq, event in ledger.events(app, "job.opened"):
                if event.payload.get("attempt_id") == attempt_id:
                    base_head = event.payload.get("base_head")
                    break
            if base_head and commit_hash and base_head != commit_hash:
                out = _git(["diff", "--name-only", f"{base_head}..{commit_hash}"],
                          cwd=project.repo)
                changed_files = [line for line in out.splitlines() if line]
        except subprocess.CalledProcessError:
            pass
    return {
        "app": app, "attempt_id": attempt_id, "status": getattr(outcome, "status"),
        "reason": getattr(outcome, "reason", None), "commit": commit_hash,
        "changed_files": changed_files, "minutes": round(wall_sec / 60.0, 2),
        "report_path": getattr(outcome, "report_path", None),
    }


def _progress_printer(kind: str) -> None:
    print(f"[{kind}] done", file=sys.stderr)


def _run_full_job_and_report(args: argparse.Namespace, config: EngineConfig,
                             job_name: str, request: str) -> int:
    """Shared tail of cmd_new/cmd_change: engine.full_orbit.run_full_job
    against this app's workspace, then the same summarize/log/print/
    exit-code handling `cmd_run` gives an ordinary `run_station`+review+
    bench job. Imported lazily (not at module import time) since
    engine.full_orbit is a separate module landing in parallel with
    this file -- a module that never calls `gb2 new`/`gb2 change` (e.g.
    `gb2 run`) must keep working even before engine.full_orbit exists."""
    from engine import full_orbit

    def fakes_for(attempt_id: str):
        return _build_fakes(config, args.app, attempt_id, None)

    ledger = Ledger.open(config.ledger_path)
    start = time.monotonic()
    try:
        outcome = full_orbit.run_full_job(
            config, ledger, fakes_for, args.app, job_name, request,
            on_progress=_progress_printer,
        )
        wall_sec = time.monotonic() - start
        summary = _summarize_full_outcome(config, ledger, args.app, outcome, wall_sec)
    finally:
        ledger.close()

    _append_run_log(args.app, {"job_name": job_name, **summary})
    print(json.dumps(summary, ensure_ascii=False))
    return _exit_code_for_full_outcome(str(summary["status"]))


def _read_requirement(args: argparse.Namespace) -> str | None:
    if args.task_file:
        return Path(args.task_file).read_text(encoding="utf-8")
    return args.task


def cmd_new(args: argparse.Namespace) -> int:
    """`gb2 new <app> "요구사항"`: refuse if the app folder already
    exists, else scaffold it from tools/templates/new-app/ (one initial
    commit), set up its engine workspace exactly like `gb2 init`, then
    run the full orbit (engine.full_orbit.run_full_job) end to end:
    facts -> plan -> [design, if the plan is a UI job] -> the task
    loop -> acceptance -> report."""
    try:
        _validate_app_name(args.app)
    except ValueError as exc:
        return _err_json(str(exc), 1)
    request = _read_requirement(args)
    if not request:
        return _err_json("requirement text (or --task-file) required", 1)
    source_repo = (_apps_root() / args.app).resolve()
    if source_repo.exists():
        return _err_json(f"app_exists: {source_repo}", 1)

    try:
        _scaffold_new_app_repo(source_repo, args.app)
        config = _setup_app_workspace(args.app, args.with_release)
    except ValueError as exc:
        return _err_json(str(exc), 1)

    job_name = args.job_name or f"gb2-new-{int(time.time())}"
    return _run_full_job_and_report(args, config, job_name, request)


