#!/usr/bin/env python3
"""gb2 -- a one-line launcher around the gongbang v2 engine
(engine.cli/engine.orbit) for a single Node/Vitest app.

    tools/gb2 init <app>                 create the engine workspace
    tools/gb2 new <app> "<요구사항>"      scaffold a brand-new app repo
                                          from tools/templates/new-app/
                                          (refuses if the app folder
                                          already exists), set up its
                                          engine workspace, then run the
                                          full orbit end to end
                                          (engine.full_orbit.run_full_job:
                                          facts -> plan -> [design] ->
                                          build loop -> acceptance ->
                                          report)
    tools/gb2 change <app> "<변경 요청>"  same full orbit as `new`,
                                          against an app `init`/`new`
                                          already set up
    tools/gb2 approve-design <app>       TTY-only: type "승인 <job>" to
                                          append a design.approved
                                          ledger event, then resume with
                                          engine.full_orbit
                                          .continue_full_job
    tools/gb2 approve-install <app>      TTY-only: show the pending
                                          install request(s) a builder
                                          station asked for, type "승인
                                          <job>" to approve+run them
                                          through engine.owner, then
                                          resume with engine.full_orbit
                                          .continue_full_job
    tools/gb2 continue <app>             resume the app's current job
                                          with engine.full_orbit
                                          .continue_full_job (e.g. after
                                          a release approval)
    tools/gb2 run <app> "<task>"         run one job end to end
    tools/gb2 run <app> --task-file f    same, task text from a file
    tools/gb2 fix <app> ["extra"]        continue the current job's
                                          attempt after it failed at
                                          review or bench, instead of
                                          starting a fresh run (see
                                          engine.fixup.fix); "extra" is
                                          optional additional owner
                                          instructions appended to the
                                          composed continue-task
    tools/gb2 fix <app> --also-own P     before continuing, widen the
                                          task currently being fixed
                                          with an extra write path `P`
                                          (repeatable; see engine.fixup.
                                          add_also_own) -- never edits
                                          plan.json itself
    tools/gb2 doctor                     check every external dependency
                                          gb2 itself relies on (python3.12,
                                          git, bwrap, claude, codex, node,
                                          npm, GB2_APPS_ROOT, and a release
                                          app's deploy script); exit 1 if
                                          anything required is missing
    tools/gb2 status <app>               engine.cli status, as JSON
    tools/gb2 log <app>                  last 5 jobs from this app's
                                          own run log (not the ledger --
                                          see gb2lib.shared.append_run_log)
    tools/gb2 diff <app>                 git diff master...gb2/work
    tools/gb2 ship <app>                 find the app's pending release
                                          publish request, show its
                                          summary, require the owner to
                                          TYPE "승인 R-..." on a TTY, then
                                          fast-forward master + deploy
    tools/gb2 skip-ship <app>            abandon the pending release
                                          publish (no deploy), finish
                                          report -> close
    tools/gb2 sync <app>                 rebase gb2/work onto the
                                          current master (refuses if the
                                          worktree is dirty)
    tools/gb2 resolve <app>              for a publish request stuck
                                          "unknown": show its receipt,
                                          run the deploy's check
                                          command, ask the owner
                                          "deployed"/"not deployed" on
                                          a TTY, then report -> close

Everything here calls existing engine.* functions (engine.steps.open_job
.open_job, engine.processor.submit, engine.orbit.continue_job,
engine.cli.cmd_status) -- no new state transition, no bypass of
processor.submit. The only new state this script keeps for itself is
app_workspace(app)/"runs.json" (a small JSON array gb2 run appends one
record to, consulted by gb2 log/status -- NOT part of the engine's own
ledger, so no engine code needs to know about it).

One engine workspace per app, under $GB2_WORKSPACE/apps/<app>/:
  config.json   generated from tools/templates/node-vitest.json
  ledger.sqlite, home/, secrets/   the engine's own state
  bench_cases.json                 one negative-control case
  repo/                            a git worktree of $GB2_APPS_ROOT/<app>,
                                    branch "gb2/work" off "master" --
                                    the ORIGINAL repo's own working
                                    tree is never touched.

Three environment variables locate everything outside this script's own
workspace tree, so nothing here hardcodes a host path:
  GB2_WORKSPACE      where this script keeps its own per-app workspaces
                      (config.json, ledger, home/, runs.json, ...).
                      Defaults to "~/.gongbang/workspace" if unset.
  GB2_APPS_ROOT      the directory holding each app's own source repo
                      (the one `init`/`init --with-release` worktree
                      off of). Required by every subcommand that
                      touches an app's repo_dir at all -- `init`,
                      `run`, `ship`, `sync`, `diff` -- since each of
                      those re-verifies repo_dir is still a real
                      worktree of GB2_APPS_ROOT/<app> before doing
                      anything else; `status`/`log`/`skip-ship` never
                      touch git and never need it.
  GB2_DEPLOY_SCRIPT  the deploy command a release-configured app's
                      top-level `publisher` argv runs. Defaults to
                      "<GB2_APPS_ROOT>/_shared/deploy.sh" if unset. Only
                      read by `init` (baked into that app's config.json
                      at that point, same as GB2_APPS_ROOT itself).

This file itself is just an argument parser + a dispatch table: every
subcommand's actual implementation lives in tools/gb2lib/ (see that
package's own docstring for how the command groups are split). The
names re-exported below (render_config, _build_fakes, _copy_node_modules,
...) exist purely so a caller that imports this module directly
(`SourceFileLoader` -- this file has no .py extension -- the way
tests/unit/test_gb2*.py load it) can still reach every one of gb2's own
public helpers as `gb2.<name>`, exactly as when they lived here; the
REAL call sites that matter for monkeypatching live in each gb2lib
submodule itself (exposed below as e.g. `gb2.workspace`, `gb2.ops`).
"""
from __future__ import annotations

import argparse
import json
import shutil  # noqa: F401 -- re-exported: tests patch gb2.shutil.which
import subprocess
import sys
from pathlib import Path

_ENGINE_ROOT = Path(__file__).resolve().parent.parent
_TOOLS_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(_ENGINE_ROOT))
sys.path.insert(0, str(_TOOLS_DIR))

from engine import fixup, orbit  # noqa: E402,F401 -- re-exported module refs
from engine.bootstrap import ensure_installed  # noqa: E402,F401 -- re-exported
from engine.cli import _build_fakes, _drain  # noqa: E402,F401 -- re-exported
from engine.ledger import Event  # noqa: E402,F401 -- re-exported

from gb2lib import ops, release_ops, runner, shared, workspace  # noqa: E402

# Flat re-exports of the names that used to live directly in this file,
# for a caller that still does `gb2.<name>` (e.g. tests/unit/test_gb2*
# .py's direct calls such as `gb2._build_fakes(...)`/`gb2.render_config
# (...)`). A plain function call through one of these names behaves
# identically either way; only `monkeypatch.setattr(gb2, "<name>", ...)`
# would NOT reach the real call site any more (that call site now lives
# in the owning gb2lib submodule) -- see each submodule's own module for
# the names a test must instead patch on e.g. `gb2.workspace`/`gb2.ops`.
APPS_DIR = shared.APPS_DIR
GB2_WORKSPACE = shared.GB2_WORKSPACE
TEMPLATES_DIR = shared.TEMPLATES_DIR
WORKTREE_BRANCH = shared.WORKTREE_BRANCH
WORKTREE_BASE = shared.WORKTREE_BASE
load_template = workspace.load_template
render_config = workspace.render_config
substitute_deploy_script = workspace.substitute_deploy_script
fill_context = workspace.fill_context
cmd_init = workspace.cmd_init
cmd_new = workspace.cmd_new
cmd_run = runner.cmd_run
cmd_fix = runner.cmd_fix
cmd_change = runner.cmd_change
cmd_approve_design = runner.cmd_approve_design
cmd_continue = runner.cmd_continue
cmd_approve_install = runner.cmd_approve_install
cmd_ship = release_ops.cmd_ship
cmd_skip_ship = release_ops.cmd_skip_ship
cmd_resolve = release_ops.cmd_resolve
cmd_status = ops.cmd_status
cmd_backup = ops.cmd_backup
cmd_log = ops.cmd_log
cmd_board = ops.cmd_board
cmd_doctor = ops.cmd_doctor
cmd_diff = ops.cmd_diff
cmd_sync = ops.cmd_sync

# Flat re-exports of every other helper a test calls directly as
# `gb2.<name>` (never monkeypatched -- the ones that ARE monkeypatched
# live only on the owning submodule, see the comment above). Same
# names tools/gb2 used before this split, now sourced from whichever
# gb2lib submodule actually owns them.
app_workspace = shared.app_workspace
NEGATIVE_CONTROL_TEST = workspace.NEGATIVE_CONTROL_TEST
NEGATIVE_CONTROL_CASES = workspace.NEGATIVE_CONTROL_CASES
BootstrapFailedError = workspace.BootstrapFailedError
_bench_cases_need_upgrade = workspace._bench_cases_need_upgrade
_detect_default_branch = workspace._detect_default_branch
_read_worktree_base = workspace.read_worktree_base
_ensure_worktree = workspace._ensure_worktree
_lockfile_snapshot = workspace._lockfile_snapshot
_commit_generated_lockfile = workspace._commit_generated_lockfile
_new_app_marker_path = workspace._new_app_marker_path
_NEW_APP_MARKER_NAME = workspace._NEW_APP_MARKER_NAME
_scaffold_new_app_repo = workspace._scaffold_new_app_repo
_validate_workspace_source_repo_disjoint = workspace._validate_workspace_source_repo_disjoint
_render_skeleton_text = workspace._render_skeleton_text
_NEW_APP_SKELETON_FILES = workspace._NEW_APP_SKELETON_FILES
