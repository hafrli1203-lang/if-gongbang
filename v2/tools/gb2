def _default_workspace_root() -> Path:
    return Path.home() / ".gongbang" / "workspace"


GB2_WORKSPACE = Path(os.environ.get("GB2_WORKSPACE", str(_default_workspace_root())))
APPS_DIR = GB2_WORKSPACE / "apps"
TEMPLATES_DIR = Path(__file__).resolve().parent / "templates"
WORKTREE_BRANCH = "gb2/work"
WORKTREE_BASE = "master"


def _apps_root() -> Path:
    """The directory holding each app's own source repo -- read lazily
    (only by the subcommands that actually need it: init, diff) rather
    than resolved at import time, so importing this module, or running
    a subcommand that only touches GB2_WORKSPACE, never requires
    GB2_APPS_ROOT to be set."""
    value = os.environ.get("GB2_APPS_ROOT")
    if not value:
        raise SystemExit(
            "GB2_APPS_ROOT is not set -- export it to the directory that "
            "holds each app's own source repo before running init/diff"
        )
    return Path(value)


def _deploy_script_path(apps_root: Path) -> Path:
    """GB2_DEPLOY_SCRIPT if set, else "<apps_root>/_shared/deploy.sh" --
    read lazily (cmd_init only), same reasoning as _apps_root."""
    value = os.environ.get("GB2_DEPLOY_SCRIPT")
    return Path(value) if value else (apps_root / "_shared" / "deploy.sh")


# A single safe path component: no "/", no leading "-" (would otherwise
# be read as an option by something downstream), not "." or "..". An
# app name is joined onto both APPS_DIR and GB2_APPS_ROOT without any
# further escaping, so accepting anything else (a "/", an absolute-
# looking value, "..") would let `gb2 init` be pointed at an arbitrary
# path outside either root -- including, in the worst case, making the
# computed workspace and source repo paths the same directory.
_APP_NAME_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def _validate_app_name(app: str) -> None:
    if app in (".", ".."):
        raise ValueError(f"invalid app name: {app!r}")
    if not _APP_NAME_RE.fullmatch(app) or app.startswith("-"):
        raise ValueError(
            f"invalid app name: {app!r} (must be a single path component "
            "matching [A-Za-z0-9._-]+, not '.', '..', or start with '-')"
        )


def _is_within(path: Path, base: Path) -> bool:
    try:
        path.relative_to(base)
        return True
    except ValueError:
        return False

NEGATIVE_CONTROL_TEST = '''\
// gb2 negative control -- fails only when GB2_NEGATIVE=1 is set, so the
// normal suite stays green while the bench can still prove its grader
// is not "always passes".
import { describe, expect, it } from "vitest";

describe("gb2 negative control", () => {
  it.skipIf(!process.env.GB2_NEGATIVE)("fails on purpose when GB2_NEGATIVE is set", () => {
    expect(1).toBe(2);
  });
});
'''

NEGATIVE_CONTROL_CASES = [
    {"name": "gb2_negative_control", "selector": "tests/gb2-negative-control.test.ts",
     "expect_fail": True, "expected_signature": "assertion", "env": {"GB2_NEGATIVE": "1"}},
]


def _bench_cases_need_upgrade(bench_cases_path: Path) -> bool:
    """True iff `bench_cases_path` already exists but its own
    "gb2_negative_control" entry's expected_signature is not the
    current one (engine.steps.bench_run._case_signature now classifies
    a real vitest assertion failure as "assertion", never "exit:1" --
    a workspace generated before that change would otherwise fail
    every bench run with wrong_failure_signature forever, since
    nothing else ever rewrites bench_cases.json once it exists)."""
    try:
        data = json.loads(bench_cases_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return False
    if not isinstance(data, list):
        return False
    for case in data:
        if (isinstance(case, dict) and case.get("name") == "gb2_negative_control"
                and case.get("expected_signature") != "assertion"):
            return True
    return False


# --------------------------------------------------------------------
# Pure helpers (unit-tested without touching git or the real filesystem
# beyond a tmp_path).
# --------------------------------------------------------------------

def load_template(path: Path) -> dict[str, object]:
    return json.loads(path.read_text(encoding="utf-8"))


def render_config(template: dict[str, object], app_name: str) -> dict[str, object]:
    """Return `template` with its single "__APP__" project key renamed
    to `app_name` -- the only per-app substitution the template needs;
    every path inside a project entry ("repo", "bench_cases", ...) is
    already relative to the app's own config.json and needs no further
    rewriting. Raises ValueError if the template's shape does not match
    (exactly one project, keyed "__APP__")."""
    projects = template.get("projects")
    if not isinstance(projects, dict) or list(projects.keys()) != ["__APP__"]:
        raise ValueError("template must have exactly one project key '__APP__'")
    rendered = dict(template)
    rendered["projects"] = {app_name: projects["__APP__"]}
    return rendered


def substitute_deploy_script(config_dict: dict[str, object],
                             deploy_script: Path) -> dict[str, object]:
    """Replace the literal "__DEPLOY_SCRIPT__" placeholder the template
    puts in the top-level publisher's argv/dry_run_argv entries with
    the real deploy script path -- the one place a path outside this
    app's own workspace needs filling in, so it is done here rather
    than baked into the template as a host-specific string."""
    publisher = config_dict.get("publisher")
    if not isinstance(publisher, dict):
        return config_dict
    rendered = dict(config_dict)
    rendered["publisher"] = {
        **publisher,
        **{
            key: [str(part).replace("__DEPLOY_SCRIPT__", str(deploy_script))
                  for part in publisher[key]]
            for key in ("argv", "dry_run_argv") if key in publisher
        },
    }
    return rendered


def app_workspace(app: str) -> Path:
    """GB2_WORKSPACE/apps/<app> -- raises ValueError for an app name
    that is not a single safe path component, or that would somehow
    still resolve outside APPS_DIR (defense in depth alongside
    _validate_app_name's own charset check)."""
    _validate_app_name(app)
    workspace = (APPS_DIR / app).resolve()
    if not _is_within(workspace, APPS_DIR.resolve()):
        raise ValueError(f"app workspace escapes GB2_WORKSPACE/apps: {app!r}")
    return workspace


def _runs_log_path(app: str) -> Path:
    return app_workspace(app) / "runs.json"


def _read_run_log(app: str) -> list[dict[str, object]]:
    path = _runs_log_path(app)
    if not path.exists():
        return []
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return []
    return data if isinstance(data, list) else []


def _append_run_log(app: str, record: dict[str, object]) -> None:
    runs = _read_run_log(app)
    runs.append(record)
    _runs_log_path(app).write_text(
        json.dumps(runs[-50:], ensure_ascii=False, indent=1), encoding="utf-8",
    )


def _git(args: list[str], cwd: Path) -> str:
    result = subprocess.run(["git", *args], cwd=str(cwd), check=True,
                            capture_output=True, text=True)
    return result.stdout.strip()


