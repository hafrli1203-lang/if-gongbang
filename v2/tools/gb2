def cmd_approve_install(args: argparse.Namespace) -> int:
    """`gb2 approve-install <app>`: TTY-only approval for a pending
    "install" request a station asked for -- a build task (engine.
    full_orbit.STAGE_TASK_OWNER) or an earlier facts/probe/plan/design
    station (STAGE_EARLY_STATION) -- found via engine.full_orbit.
    pending_owner_requests, the station.finished "requests" entry a
    full-orbit job is currently stopped on. Shows what manifest/change
    each one is asking for, requires the owner to TYPE the exact "승인 <job>" line (same
    TTY convention as `gb2 approve-design`/`gb2 ship`, refused outright
    on a non-interactive shell), then submits/approves each one through
    the EXISTING engine.owner.validate_pending/approve_pending gate --
    never re-implementing that validation here -- and drains the
    processor queue (engine.cli._drain) so the install actually runs
    before anything else happens. Only once every pending request is
    confirmed "done" does this resume the job with engine.full_orbit.
    continue_full_job, which (since b0c8208) reruns the builder task
    that stopped from where it left off, rather than skipping straight
    to review."""
    config_path = app_workspace(args.app) / "config.json"
    if not config_path.exists():
        return _err_json(f"not initialized: run `gb2 init {args.app}` first", 1)
    _verify_app_repo_identity(args.app)
    if not sys.stdin.isatty():
        return _err_json("refused: non-interactive shell, approve-install requires a TTY", 4)
    config = EngineConfig.from_json(config_path)
    try:
        config, fakes_for = _fakes_builder(config, args.app)
    except ValueError as exc:
        return _err_json(str(exc), 1)

    from engine import full_orbit
    from engine import owner as owner_module

    ledger = Ledger.open(config.ledger_path)
    try:
        project_row = ledger.project(args.app)
        attempt_id = project_row.current_attempt_id
        if attempt_id is None:
            return _err_json("no_active_job", 1)
        job_name = _job_name_for_attempt(ledger, args.app, attempt_id)

        pending = [req for req in full_orbit.pending_owner_requests(ledger, args.app, job_name)
                   if req.get("kind") == "install"]
        if not pending:
            return _err_json("no_pending_install_request", 1)

        print(json.dumps({"job_name": job_name, "pending_install_requests": pending},
                         ensure_ascii=False, indent=1, sort_keys=True), file=sys.stderr)

        owner_text = input(f'type the approval line exactly ("승인 {job_name}"): ')
        if owner_text != f"승인 {job_name}":
            return _err_json("refused: approval line did not match, nothing changed", 1)

        for request in pending:
            try:
                request_id = owner_module.approve_pending(
                    config, ledger, args.app, attempt_id, request,
                    confirm=True, confirm_source="tty",
                )
            except ValueError as exc:
                return _err_json(f"approve_pending_refused: {exc}", 1)
            status = _drain(config, ledger, args.app, attempt_id, request_id)
            if status != "done":
                return _err_json(f"install_request_failed: {request_id} status={status}", 3)

        start = time.monotonic()
        outcome = full_orbit.continue_full_job(
            config, ledger, fakes_for, args.app, job_name, on_progress=_progress_printer,
        )
        wall_sec = time.monotonic() - start
        summary = _summarize_full_outcome(config, ledger, args.app, outcome, wall_sec)
    finally:
        ledger.close()

    _append_run_log(args.app, {"job_name": job_name, **summary})
    print(json.dumps(summary, ensure_ascii=False))
    return _exit_code_for_full_outcome(str(summary["status"]))


