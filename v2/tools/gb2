_find_unknown_publish = release_ops._find_unknown_publish
_find_running_publish = release_ops._find_running_publish
_publish_request_ids_for_attempt = release_ops._publish_request_ids_for_attempt
_check_argv = release_ops._check_argv
_project_lock_is_free = release_ops._project_lock_is_free


_HANDLERS = {
    "init": cmd_init, "run": cmd_run, "fix": cmd_fix, "status": cmd_status, "backup": cmd_backup,
    "log": cmd_log, "diff": cmd_diff, "ship": cmd_ship,
    "skip-ship": cmd_skip_ship, "sync": cmd_sync, "resolve": cmd_resolve,
    "new": cmd_new, "change": cmd_change, "approve-design": cmd_approve_design,
    "approve-install": cmd_approve_install,
    "continue": cmd_continue, "board": cmd_board, "doctor": cmd_doctor,
}


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="gb2")
    sub = parser.add_subparsers(dest="command", required=True)

    p_init = sub.add_parser("init")
    p_init.add_argument("app")
    p_init.add_argument("--with-release", action="store_true",
                        help="turn on the release track: this app's "
                             "publish requests target its own original "
                             "repo (never its gb2/work worktree)")

    p_run = sub.add_parser("run")
    p_run.add_argument("app")
    p_run.add_argument("task", nargs="?", default=None)
    p_run.add_argument("--task-file", default=None)
    p_run.add_argument("--job-name", default=None)

    p_fix = sub.add_parser("fix")
    p_fix.add_argument("app")
    p_fix.add_argument("extra", nargs="?", default=None)
    p_fix.add_argument("--also-own", dest="also_own", action="append", default=[],
                       help="widen the task currently being fixed with an extra "
                            "write path (repeatable) -- see engine.fixup.add_also_own")

    p_status = sub.add_parser("status")
    p_status.add_argument("app")

    p_backup = sub.add_parser("backup")
    p_backup.add_argument("app")
    p_backup.add_argument("--dest", default=None)
    p_backup.add_argument("--keep", type=int, default=10)

    p_log = sub.add_parser("log")
    p_log.add_argument("app")

    p_diff = sub.add_parser("diff")
    p_diff.add_argument("app")

    p_ship = sub.add_parser("ship")
    p_ship.add_argument("app")

    p_skip_ship = sub.add_parser("skip-ship")
    p_skip_ship.add_argument("app")

    p_sync = sub.add_parser("sync")
    p_sync.add_argument("app")

    p_resolve = sub.add_parser("resolve")
    p_resolve.add_argument("app")

    p_new = sub.add_parser("new")
    p_new.add_argument("app")
    p_new.add_argument("task", nargs="?", default=None)
    p_new.add_argument("--task-file", default=None)
    p_new.add_argument("--job-name", default=None)
    p_new.add_argument("--with-release", action="store_true",
                       help="turn on the release track: this app's "
                            "publish requests target its own original "
                            "repo (never its gb2/work worktree)")

    p_change = sub.add_parser("change")
    p_change.add_argument("app")
    p_change.add_argument("task", nargs="?", default=None)
    p_change.add_argument("--task-file", default=None)
    p_change.add_argument("--job-name", default=None)
    p_change.add_argument("--small", action="store_true",
                          help="fast path for a small change: one combined "
                               "facts+plan call instead of three separate "
                               "stations (engine.small_orbit). Falls back "
                               "to the full job automatically if facts.md "
                               "ends up naming a real external dependency.")

    p_approve_design = sub.add_parser("approve-design")
    p_approve_design.add_argument("app")

    p_approve_install = sub.add_parser("approve-install")
    p_approve_install.add_argument("app")

    p_continue = sub.add_parser("continue")
    p_continue.add_argument("app")
    p_continue.add_argument("--from", dest="from_station", default=None,
                            choices=("facts", "probe", "plan"),
                            help="reopen from this early station instead of "
                                 "the ordinary resume point -- e.g. an owner/"
                                 "foreman scope decision made after facts.md "
                                 "was written needs facts.md itself redone. "
                                 "Refused if the job is not currently stopped "
                                 "at an early station, or if this names a "
                                 "station LATER than the one it is stopped "
                                 "at.")

    sub.add_parser("doctor")

    p_board = sub.add_parser("board")
    p_board.add_argument("app", nargs="?", default=None,
                         help="omit to build one page across every app")
    p_board.add_argument("--out", default=None,
                         help="output HTML path (default: "
                              "$GB2_WORKSPACE/board.html)")
    p_board.add_argument("--lessons-export", default=None,
                         help="path to a JSON file holding a list of "
                              "lesson records (optional)")
    p_board.add_argument("--queue", default=None,
                         help="path to a WORK_QUEUE-like markdown file "
                              "(optional)")

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = _build_parser()
    args = parser.parse_args(argv)
    try:
        return _HANDLERS[args.command](args)
    except FileNotFoundError as exc:
        print(json.dumps({"error": f"not_found: {exc}"}), file=sys.stderr)
        return 1
    except (ValueError, OSError, subprocess.CalledProcessError) as exc:
        print(json.dumps({"error": f"{type(exc).__name__}: {exc}"}), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
