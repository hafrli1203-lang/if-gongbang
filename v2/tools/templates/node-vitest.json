{
  "ledger_path": "ledger.sqlite",
  "home": "home",
  "secrets_dir": "secrets",
  "sandbox": "bwrap",
  "approval_ttl_sec": 14400,
  "parallel_review_bench": true,
  "projects": {
    "__APP__": {
      "repo": "repo",
      "excludes": [
        "node_modules",
        ".next",
        "tsconfig.tsbuildinfo",
        "dist",
        "build",
        ".env",
        ".env.local"
      ],
      "copy_links": [
        "node_modules"
      ],
      "test_cmd": [
        "npx",
        "vitest",
        "run",
        "--no-color"
      ],
      "bench_scope": "related",
      "related_cmd": [
        "npx",
        "vitest",
        "related",
        "--run",
        "--no-color",
        "{files}"
      ],
      "builder_test_hint": "While editing, run only the tests related to the files you're changing (e.g. `npx vitest related --run <changed files>`), to get fast feedback. Run the full suite (`npx vitest run`) at most once, right before you finish.",
      "test_timeout_sec": 600,
      "manifest": "package.json",
      "install_cmd": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund"
      ],
      "bench_cases": "../bench_cases.json",
      "copy_link_writable_subpaths": {
        "node_modules": [
          ".vite",
          ".vite-temp",
          ".cache"
        ]
      },
      "release": null
    }
  },
  "publisher": {
    "kind": "shell",
    "argv": [
      "__DEPLOY_SCRIPT__",
      "{target}"
    ],
    "dry_run_argv": [
      "__DEPLOY_SCRIPT__",
      "{target}",
      "--check"
    ],
    "dry_run": false
  },
  "station_owners": {
    "facts": {
      "facts": [
        ".gongbang/"
      ]
    },
    "probe": {
      "prober": [
        ".gongbang/"
      ]
    },
    "plan": {
      "planner": [
        ".gongbang/",
        "tests/scenes/"
      ]
    },
    "design": {
      "designer": [
        ".gongbang/"
      ]
    },
    "build": {
      "builder": [
        "src/",
        "tests/",
        "docs/ai/"
      ]
    }
  },
  "station_terminal_allow": {
    "probe": {
      "prober": [
        "python3 \\.gongbang/[A-Za-z0-9_./-]+",
        "node \\.gongbang/[A-Za-z0-9_./-]+",
        "bash \\.gongbang/[A-Za-z0-9_./-]+"
      ]
    },
    "build": {
      "builder": [
        "npx vitest run( [A-Za-z0-9_./\\[\\]-]+)*",
        "npx vitest related --run( [A-Za-z0-9_./\\[\\]-]+)*",
        "npx tsc --noEmit",
        "npm run typecheck",
        "npx eslint src( [A-Za-z0-9_./-]+)*",
        "git status( --short)?",
        "git diff( --stat)?( -- [A-Za-z0-9_./\\[\\]-]+)?",
        "ls( -la?)?( [A-Za-z0-9_./\\[\\]-]+)?"
      ]
    }
  },
  "protected_paths": [
    ".gitignore",
    "package-lock.json",
    ".env",
    ".env.local",
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "workers": {
    "facts": {
      "runner": "claude",
      "model": "sonnet",
      "timeout_sec": 600
    },
    "prober": {
      "runner": "claude",
      "model": "sonnet",
      "timeout_sec": 900
    },
    "planner": {
      "runner": "claude",
      "model": "sonnet",
      "timeout_sec": 900
    },
    "designer": {
      "runner": "claude",
      "model": "sonnet",
      "timeout_sec": 900
    },
    "builder": {
      "runner": "claude",
      "model": "sonnet",
      "timeout_sec": 1500
    },
    "reviewer": {
      "runner": "codex",
      "timeout_sec": 900,
      "reasoning": "medium"
    }
  },
  "bench_readonly_paths": [
    "~/.cache/ms-playwright",
    "~/.npm"
  ],
  "skill_index_path": "~/.claude/skills-library/INDEX.md",
  "mcp_servers": {
    "playwright": {
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "args": [],
      "env_passthrough": []
    }
  },
  "station_mcp_allow": {
    "design": [
      "playwright"
    ],
    "review": [
      "playwright"
    ],
    "build": [
      "playwright"
    ]
  },
  "mcp_tool_allow": {
    "playwright": [
      "browser_navigate",
      "browser_snapshot",
      "browser_take_screenshot",
      "browser_click",
      "browser_type",
      "browser_wait_for",
      "browser_console_messages",
      "browser_resize",
      "browser_close"
    ]
  },
  "security": {
    "audit_cmd": [
      "npm",
      "audit",
      "--omit=dev",
      "--json"
    ]
  },
  "context": {
    "skill_roots": [
      "~/.claude/skills",
      "~/.claude/skills-library"
    ],
    "station_skills": {
      "facts": [
        "크래시-아웃"
      ],
      "plan": [
        "writing-plans",
        "육칠",
        "skill-library"
      ],
      "design": [
        "아우라-파밍",
        "impeccable",
        "화면-품질-점검"
      ],
      "review": [
        "화면-품질-점검"
      ],
      "report": [
        "진행-보고"
      ]
    }
  }
}
