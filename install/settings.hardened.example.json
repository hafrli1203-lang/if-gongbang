{
  "_comment": "강화 설치 예시. install/settings.example.json의 hooks 등록에 Bash sandbox + Edit 거부 규칙을 더한 것이다. 경로는 자신의 설치 위치로 바꾼다. 자세한 설명은 docs/hardening.md를 먼저 읽는다.",
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "denyWrite": [
        "~/.claude/hooks",
        "~/.claude/gate",
        "~/.claude/settings.json",
        "~/.claude/settings.local.json",
        "~/.claude/projects"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/gate/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/projects/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 /absolute/path/to/hooks/approve_gate.py" },
          { "type": "command", "command": "python3 /absolute/path/to/hooks/lesson_capture.py" },
          { "type": "command", "command": "python3 /absolute/path/to/hooks/library_nudge.py" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 /absolute/path/to/hooks/block_dangerous.py" },
          { "type": "command", "command": "python3 /absolute/path/to/hooks/scope_guard.py" },
          { "type": "command", "command": "python3 /absolute/path/to/hooks/preflight_gate.py" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 /absolute/path/to/hooks/scope_guard.py" },
          { "type": "command", "command": "python3 /absolute/path/to/hooks/preflight_gate.py" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 /absolute/path/to/hooks/verify_claims.py" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash /absolute/path/to/hooks/next_task.sh" },
          { "type": "command", "command": "python3 /absolute/path/to/hooks/lesson_start.py" }
        ]
      }
    ]
  }
}
